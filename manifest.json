{
  "manifest_version": 3,
  "name": "Brightlight Migrator",
  "version": "2.0.0",
  "description": "Copies a clinic's own Jane records into Brightlight Health. Driven from Brightlight; nothing is configured here.",
  "key": "",
  "icons": {
    "16": "16.png",
    "48": "48.png",
    "128": "128.png"
  },
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.janeapp.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.brightlight.ai/*",
      "http://localhost/*"
    ]
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Brightlight Migrator"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
